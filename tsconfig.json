{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"downlevelIteration": true,
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts"],
		"types": ["types", "compiler-types"],
		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": ["src/Dynamo.d.ts"]
}
